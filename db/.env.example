# Copy to db/.env or export in the shell / Railway service.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ankil

# Optional alternative (Railway often provides this):
# MYSQL_URL=mysql://user:password@host:3306/ankil
# DATABASE_URL=mysql://user:password@host:3306/ankil

# Path to seed file (only for the one-time import)
CSV_PATH=../publications.csv
